{
  "name": "dsh-locale-ru",
  "version": "1.0.0",
  "description": "Russian language pack for the DeepSeek Harness web GUI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "i18n",
    "localization",
    "russian",
    "language-pack"
  ],
  "author": "xzdes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzdes/dsh-locale-ru.git"
  },
  "homepage": "https://github.com/xzdes/dsh-locale-ru#readme",
  "bugs": "https://github.com/xzdes/dsh-locale-ru/issues"
}
